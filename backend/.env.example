# Copy this file to .env and fill in real values. Never commit .env.

APP_ENV=local

# Local Postgres (Windows install). Render sets this automatically in deploy.
DATABASE_URL=postgresql://taggify:taggify_dev@localhost:5432/taggify_dev

# Used by pytest
TEST_DATABASE_URL=postgresql://taggify:taggify_dev@localhost:5432/taggify_test

# Session cookie: must be true when served over HTTPS (Render)
COOKIE_SECURE=false

# Cloudflare R2 for uploaded files (contracts, CMS statements). Leave empty locally:
# files are then kept in the database.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# YouTube channel tokens are stored encrypted with this key (generate once, never change):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
# Secret the daily scheduler sends as X-Sync-Secret to POST /api/internal/youtube-sync
SYNC_SECRET=
