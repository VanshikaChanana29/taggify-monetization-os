# Where the Next.js server proxies /api/* (server-side only, read at build time)
API_URL=http://localhost:8000

# Optional, local only: demo accounts listed under the login form in `npm run dev`.
# Never shown in a production build. Format: Label|email|password;Label|email|password
# NEXT_PUBLIC_DEV_LOGINS=Super Admin|you@example.com|your-local-password;Founder|founder@example.com|another-password
